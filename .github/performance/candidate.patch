+import fs from "node:fs/promises";
+import path from "node:path";
+import vm from "node:vm";
+import { createRequire } from "node:module";
+
+// VM modules let these checks observe lazy initialization without changing the SDK.
+export async function loadProxy({ root, baseline = false, localTest = false, makeMiddleware }) {
+  const require = createRequire(path.join(root, "package.json"));
+  const ts = require("typescript");
+  const { NextResponse } = require("next/server");
+  const { createRouteMatcher } = require("@clerk/nextjs/server");
+  const context = vm.createContext({ URL, console });
+  const stats = { factories: 0, delegations: 0, protects: 0, dynamicImports: 0, users: new WeakMap() };
+  const cache = new Map();
+  function synthetic(key, exports) {
+    const mod = new vm.SyntheticModule(Object.keys(exports), function () {
+      for (const [name, value] of Object.entries(exports)) this.setExport(name, value);
+    }, { context, identifier: key });
+    return mod;
+  }
+  const clerk = synthetic("clerk", {
+    createRouteMatcher,
+    clerkMiddleware(callback) {
+      stats.factories++;
+      return makeMiddleware(callback, stats);
+    },
+  });
+  const next = synthetic("next", { NextResponse });
+  const local = synthetic("local", { isLocalTestAuthEnabled: () => localTest });
+  async function resolve(spec, parent) {
+    if (spec === "@clerk/nextjs/server") return clerk;
+    if (spec === "next/server") return next;
+    if (spec.endsWith("localTestAuth")) return local;
+    const file = spec.startsWith("@/")
+      ? path.join(root, spec.slice(2) + ".ts")
+      : path.resolve(path.dirname(parent.identifier), spec + ".ts");
+    return fileModule(file);
+  }
+  async function fileModule(file) {
+    if (cache.has(file)) return cache.get(file);
+    const source = await fs.readFile(file, "utf8");
+    const code = ts.transpileModule(source, { compilerOptions: {
+      module: ts.ModuleKind.ESNext, target: ts.ScriptTarget.ES2022,
+    } }).outputText;
+    const mod = new vm.SourceTextModule(code, {
+      context, identifier: file,
+      importModuleDynamically: async (spec, parent) => {
+        stats.dynamicImports++;
+        const child = await resolve(spec, parent);
+        if (child.status === "unlinked") await child.link(resolve);
+        if (child.status === "linked") await child.evaluate();
+        return child;
+      },
+    });
+    cache.set(file, mod);
+    await mod.link(resolve);
+    return mod;
+  }
+  const entry = baseline ? "tests/fixtures/proxy-before-lazy.ts" : "proxy.ts";
+  const mod = await fileModule(path.join(root, entry));
+  await mod.evaluate();
+  return { proxy: mod.namespace.default, config: mod.namespace.config, stats };
+}
