+  const candidate = await loadProxy({ root, localTest, makeMiddleware: policyMiddleware });
+  assert.deepEqual(JSON.parse(JSON.stringify(candidate.config)), JSON.parse(JSON.stringify(baseline.config)));
+  assert.equal(candidate.stats.factories, 0);
+  for (const pathname of paths) for (const method of ["GET", "POST", "OPTIONS"]) for (const cookie of [false, true]) for (const valid of [false, true]) {
+    const args = [pathname, method, cookie, valid];
+    assert.deepEqual(await policyResult(candidate, ...args), await policyResult(baseline, ...args), JSON.stringify({ localTest, pathname, method, cookie, valid }));
+    policyCases++;
