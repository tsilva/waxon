+  return clerkMiddleware(async (auth, request, sdkEvent) => {
+    stats.users.set(request, (await auth()).userId);
+    return callback(auth, request, sdkEvent);
+  }, { jwtKey, authorizedParties: ["https://waxon.invalid"], clockSkewInMs: 0 });
+}
+const cases = [
