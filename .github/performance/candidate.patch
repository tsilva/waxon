+}
+const publicOnly = await loadProxy({ root, makeMiddleware: policyMiddleware });
+for (const pathname of ["/", "/privacy-policy", "/robots.txt", "/sitemap.xml", "/terms-and-conditions", "/library", "/review", "/api/mcp"]) {
+  await publicOnly.proxy(new NextRequest("https://waxon.invalid" + pathname), event);
+}
+assert.equal(publicOnly.stats.factories, 0);
+assert.equal(publicOnly.stats.dynamicImports, 0);
+
+function token(user, expired = false, forged = false) {
+  const now = Math.floor(Date.now() / 1000);
+  const header = { alg: "RS256", typ: "JWT", kid: "fixture-rsa" };
+  const payload = { iss: "https://frontend.example.com", sub: user, sid: "sess_fixture", azp: "https://waxon.invalid", iat: now - 60, nbf: now - 60, exp: expired ? now - 10 : now + 300, v: 2, fva: [1, -1] };
+  const data = [header, payload].map((item) => Buffer.from(JSON.stringify(item)).toString("base64url")).join(".");
