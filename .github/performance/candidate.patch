+import { createRequire } from "node:module";
+import path from "node:path";
+import { loadProxy } from "./proxy-fixture-loader.mjs";
+
+const root = process.cwd();
+const require = createRequire(path.join(root, "package.json"));
+const { NextRequest, NextResponse } = require("next/server");
+const blockedNetwork = [];
+globalThis.fetch = async () => {
+  blockedNetwork.push(true);
+  throw new Error("Synthetic auth fixture blocks upstream requests");
+};
+// These are public placeholders. Signing keys and tokens exist only in memory.
+process.env.CLERK_SECRET_KEY = "sk_test_fixture";
+process.env.NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY = "pk_test_ZnJvbnRlbmQuZXhhbXBsZS5jb20k";
+const { publicKey, privateKey } = generateKeyPairSync("rsa", { modulusLength: 2048 });
+const jwtKey = publicKey.export({ type: "spki", format: "pem" });
+process.env.CLERK_JWT_KEY = jwtKey;
+const { clerkMiddleware } = require("@clerk/nextjs/server");
+const silent = () => {};
+console.warn = silent;
+console.error = silent;
+const event = { waitUntil() {}, sourcePage: "proxy" };
+function policyMiddleware(callback, stats) {
+  return async (request) => {
+    stats.delegations++;
+    const auth = Object.assign(async () => ({}), { protect: async () => {
+      stats.protects++;
+      if (request.headers.get("x-fixture-auth") !== "valid") {
+        throw Object.assign(new Error("fixture unauthorized"), { status: 401 });
+      }
+    } });
+    await callback(auth, request, event);
+    return NextResponse.next();
+  };
+}
+async function policyResult(implementation, pathname, method, cookie, valid) {
+  const before = { ...implementation.stats };
+  const request = new NextRequest("https://waxon.invalid" + pathname, { method, headers: {
+    ...(cookie ? { cookie: "__session=fixture-invalid-session" } : {}),
+    ...(valid ? { "x-fixture-auth": "valid" } : {}),
+  } });
+  let response;
+  try {
+    const result = await implementation.proxy(request, event);
+    response = { status: result?.status, location: result?.headers.get("location"), next: result?.headers.get("x-middleware-next") };
+  } catch (error) { response = { error: error.message, status: error.status }; }
+  return { ...response, delegations: implementation.stats.delegations - before.delegations, protects: implementation.stats.protects - before.protects };
+}
+const paths = ["/", "/?q=x", "/privacy-policy", "/privacy-policy/", "/robots.txt", "/sitemap.xml", "/terms-and-conditions", "/library", "/library/nested", "/libraryish", "/review", "/review/nested", "/reviewer", "/admin", "/admin/trace", "/administrator", "/api", "/api/v2/settings", "/api/mcp", "/api/mcp/nested", "/api/mcpx", "/sign-in", "/sign-up", "/__clerk", "/trpc", "/%61dmin", "/api%2fv2/settings"];
+let policyCases = 0;
+for (const localTest of [false, true]) {
