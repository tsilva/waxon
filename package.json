{
  "name": "waxon",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "node scripts/next-server.mjs dev",
    "build": "next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reset": "node scripts/reset-v2.mjs",
    "db:studio": "drizzle-kit studio",
    "lean:preflight": "node --experimental-strip-types scripts/lean-core-preflight.mts",
    "start": "node scripts/next-server.mjs start",
    "test": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "security:check": "node scripts/check-dependency-sources.mjs && pnpm audit --audit-level=low"
  },
  "dependencies": {
    "@clerk/nextjs": "7.4.2",
    "@modelcontextprotocol/server": "2.0.0",
    "@sentry/nextjs": "^10.55.0",
    "@vercel/analytics": "1.6.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.16.0",
    "next": "^16.3.0",
    "pg": "8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ts-fsrs": "5.4.1",
    "workflow": "4.7.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@types/node": "^24.3.0",
    "@types/pg": "8.15.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.34.0",
    "eslint-config-next": "^16.3.0",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "overrides": {
      "@clerk/nextjs>@clerk/backend": "3.4.14",
      "@clerk/nextjs>@clerk/react": "6.7.2",
      "@clerk/nextjs>@clerk/shared": "4.14.0",
      "@esbuild-kit/core-utils>esbuild": "0.25.0",
      "@workflow/core>nanoid": "5.1.16",
      "nanoid@<4": "3.3.18",
      "undici@>=6 <7": "6.28.0",
      "undici@>=7 <7.29.0": "7.29.0"
    }
  },
  "packageManager": "pnpm@10.33.0"
}
