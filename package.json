{
  "name": "waxon",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "python3 scripts/infisical/run.py dev",
    "build": "node scripts/build.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reset": "node scripts/reset-v2.mjs",
    "db:studio": "drizzle-kit studio",
    "question-search:evaluate": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/question-search-evaluate.mts",
    "question-search:benchmark": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/question-search-benchmark.mts",
    "semantic-tags:benchmark": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/semantic-tags-benchmark.mts",
    "semantic-tags:backfill": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/backfill-semantic-tag-space.mts",
    "semantic-tags:calibrate": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/calibrate-semantic-tag-threshold.mts",
    "question-quality:report": "node --import tsx scripts/question-quality-report.mts",
    "question-quality:experiment": "node --import tsx scripts/question-quality-experiment.mts",
    "recall-evaluator:smoke": "node --import tsx scripts/recall-evaluator-smoke.mts",
    "start": "node scripts/next-server.mjs start",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.mts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "security:check": "node scripts/check-dependency-sources.mjs && pnpm audit --audit-level=low",
    "performance:benchmark": "node --import tsx scripts/performance-benchmark.mts",
    "dev:app": "node scripts/next-server.mjs dev",
    "build:secrets": "python3 scripts/infisical/run.py build",
    "start:secrets": "python3 scripts/infisical/run.py start",
    "db:migrate:secrets": "python3 scripts/infisical/run.py migrate",
    "secrets:check": "python3 scripts/infisical/run.py check",
    "secrets:migrate:keyenv": "python3 scripts/infisical/migrate_keyenv.py",
    "test:secrets": "python3 -m unittest discover -s scripts/infisical -p test_secrets.py"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.7",
    "@modelcontextprotocol/server": "2.2.0",
    "@sentry/nextjs": "^10.55.0",
    "@vercel/analytics": "1.6.1",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.48.0",
    "next": "16.3.7",
    "pg": "8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-fsrs": "5.4.2",
    "workflow": "4.8.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@types/jsdom": "21.1.7",
    "@types/node": "^24.3.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.34.0",
    "eslint-config-next": "^16.3.7",
    "jsdom": "26.1.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "overrides": {
      "@clerk/nextjs>@clerk/backend": "3.4.14",
      "@clerk/nextjs>@clerk/react": "6.7.2",
      "@clerk/nextjs>@clerk/shared": "4.14.0",
      "@esbuild-kit/core-utils>esbuild": "0.25.0",
      "@workflow/core>nanoid": "5.1.16",
      "nanoid@<4": "3.3.18",
      "undici@>=6 <7": "6.28.0",
      "undici@>=7 <7.29.0": "7.29.0"
    }
  },
  "packageManager": "pnpm@10.33.0"
}
